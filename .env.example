# Copy to .env and start with: uvicorn app.main:app --port 8000 --env-file .env
# Every value is optional. Never commit the real .env.

# Enables Gemini answers; without it the extractive answerer is used
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Retrieval and chunking
TOP_K=5
MIN_SIMILARITY=0.30
CHUNK_CHARS=900
CHUNK_OVERLAP=160

# Storage and upload limits
DATA_DIR=./data
MAX_UPLOAD_MB=10
MAX_UPLOADED_DOCS=25
